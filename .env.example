# Clerk Authentication (use a development instance: pk_test_ / sk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Database - Supabase Postgres (Dashboard -> Connect -> Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Stripe (test mode keys for local development)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local: the whsec_ printed by `stripe listen`; production: the endpoint's signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Seed script (optional): Clerk user id that owns the seeded products.
# Defaults to the most recently created Clerk user.
# SEED_USER_ID=user_...

# Playwright E2E (optional). Password user in the Clerk DEVELOPMENT instance.
# Authenticated tests are skipped when either value is missing.
# E2E_CLERK_USER_USERNAME=e2e+clerk_test@example.com
# E2E_CLERK_USER_PASSWORD=your_test_user_password
# E2E_PORT=3101
